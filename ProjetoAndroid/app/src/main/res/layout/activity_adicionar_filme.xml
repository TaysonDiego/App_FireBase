<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context="Modelo.AdicionarFilmeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imagemFilme"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="15dp"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars" />

            <Button
                android:id="@+id/btnEscolherFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="EscolherFotoEvt"
                android:text="Capa"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue"
                android:layout_marginBottom="20dp"/>


            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome do Filme"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:backgroundTint="@color/red"/>


            <EditText
                android:id="@+id/edtGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gerenero"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:backgroundTint="@color/red"/>

            <EditText
                android:id="@+id/edtAno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Ano"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:backgroundTint="@color/red"/>


            <EditText
                android:id="@+id/edtClassificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Classificacao"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:backgroundTint="@color/red"/>


            <EditText
                android:id="@+id/edtDuracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Duracao (min)"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:backgroundTint="@color/red"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="25dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnInserir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="InserirTap"
                    android:text="Salvar"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/green"/>

                <Button
                    android:id="@+id/btnAtualizar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="AtualizarTap"
                    android:text="Atualizar"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/blue"
                    android:layout_marginStart="10dp"/>

                <Button
                    android:id="@+id/btnRemover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="DeletarTap"
                    android:text="Excluir"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
